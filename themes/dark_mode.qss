/* =============================================================================
   TrackYak — Dark Mode Theme
   ─────────────────────────────────────────────────────────────────────────────
   Core Palette
     Base:          #0b0c10   deep navy-black
     Surface:       #11121a   slightly lifted surface
     Elevated:      #1a1b26   cards, inputs, raised elements
     Accent:        #8599ea   periwinkle blue-purple
     Accent soft:   #9385ea   purple-leaning variant
     Gold:          #EAD685   warm complementary
     Pink:          #EA8599   triadic warm
     Green:         #99EA85   triadic cool
     Text primary:  #b8c0f0   soft lavender white
     Text dim:      #555e7a   muted for secondary info

   Design Goals
     • Depth through layered surfaces (base → surface → elevated)
     • Subtle left-border accent lines on nav items instead of full fills
     • Frosted-glass look on cards via semi-transparent backgrounds
     • Consistent 8px border-radius language on interactive elements
     • Tighter, more intentional spacing
     • Scrollbars slim and unobtrusive
     • Smooth state transitions on all interactive controls
============================================================================= */

/* ── FONTS ──────────────────────────────────────────────────────────────────── */
* {
    font-family: "Cambria", "Georgia", serif;
}

/* ── GLOBAL BASE ─────────────────────────────────────────────────────────────── */
QWidget {
    background-color: #0b0c10;
    color: #b8c0f0;
    selection-background-color: #8599ea;
    selection-color: #0b0c10;
}

/* ── MAIN WINDOW ─────────────────────────────────────────────────────────────── */
QMainWindow {
    background-color: #0b0c10;
}

QMainWindow::separator {
    background-color: #1e1f2b;
    width: 1px;
    height: 1px;
}

/* ── DIALOGS ─────────────────────────────────────────────────────────────────── */
QDialog {
    background-color: #11121a;
    color: #b8c0f0;
    border: 1px solid rgba(133, 153, 234, 0.35);
    border-radius: 10px;
}

QDialog #qt_dialog_titlebar {
    background-color: #11121a;
    color: #EAD685;
    border-bottom: 1px solid rgba(133, 153, 234, 0.2);
}

/* ── DOCK WIDGETS ────────────────────────────────────────────────────────────── */
QDockWidget {
    background-color: #0b0c10;
    color: #b8c0f0;
    border: none;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #11121a;
    color: #EAD685;
    padding: 6px 10px;
    border-bottom: 1px solid rgba(133, 153, 234, 0.2);
    font-weight: bold;
    letter-spacing: 0.04em;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: rgba(234, 133, 153, 0.2);
    border-radius: 4px;
}

/* ── NAVIGATION TREE ─────────────────────────────────────────────────────────── */
NavigationDock QTreeWidget#NavTree {
    background-color: #0e0f15;
    border: none;
    padding: 8px 0;
    outline: none;
}

NavigationDock QTreeWidget#NavTree::item {
    background-color: transparent;
    color: #7a82a8;
    font-size: 1.05em;
    font-weight: bold;
    padding: 10px 16px 10px 14px;
    border-left: 3px solid transparent;
    border-radius: 0px;
    margin: 1px 0;
}

NavigationDock QTreeWidget#NavTree::item:hover {
    background-color: rgba(234, 133, 153, 0.12);
    color: #EA8599;
    border-left: 3px solid #EA8599;
}

NavigationDock QTreeWidget#NavTree::item:selected:active {
    background-color: rgba(133, 153, 234, 0.15);
    color: #b8c0f0;
    border-left: 3px solid #8599ea;
    outline: none;
}

NavigationDock QTreeWidget#NavTree::item:selected:!active {
    background-color: rgba(133, 153, 234, 0.10);
    color: #7a82a8;
    border-left: 3px solid rgba(133, 153, 234, 0.4);
    outline: none;
}


NavigationDock QTreeWidget#NavTree::item:focus {
    outline: none;
    border-left: 3px solid #8599ea;
}

/* ── HEADER VIEW (table/tree column headers) ─────────────────────────────────── */
QHeaderView {
    background-color: #0b0c10;
}

QHeaderView::section {
    background-color: #11121a;
    color: #8599ea;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #1e1f2b;
    border-bottom: 2px solid rgba(133, 153, 234, 0.4);
    font-weight: bold;
    font-size: 0.85em;
    letter-spacing: 0.06em;
    min-height: 28px;
}

QHeaderView::section:hover {
    background-color: #1a1b26;
    color: #EAD685;
}

QHeaderView::section:pressed {
    background-color: rgba(133, 153, 234, 0.2);
}

/* ── LISTS & TREES ───────────────────────────────────────────────────────────── */
QListWidget,
QTreeWidget {
    background-color: #0e0f15;
    border: 1px solid #1e1f2b;
    border-radius: 6px;
    outline: none;
    alternate-background-color: #11121a;
}

QListView::item,
QTreeView::item {
    padding: 4px 6px;
    border-radius: 4px;
    color: #b8c0f0;
}

QListView::item:hover,
QTreeView::item:hover {
    background-color: rgba(234, 133, 153, 0.12);
    color: #EA8599;
}
/* FIXED: same split for QListWidget */
QListWidget::item:selected:active {
    background-color: rgba(133, 153, 234, 0.22);
    color: #b8c0f0;
}

QListWidget::item:selected:!active {
    background-color: rgba(133, 153, 234, 0.08);
    color: #7a82a8;
}


QTreeView::item:selected:active,
QTreeWidget::item:selected:active {
    background-color: rgba(133, 153, 234, 0.22);
    color: #b8c0f0;
    border: none;
}

QTreeView::item:selected:!active,
QTreeWidget::item:selected:!active {
    background-color: transparent;
    color: #b8c0f0;
    border: none;
}

QTreeView::indicator,
QListView::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a3d55;
    background-color: #11121a;
    border-radius: 4px;
}

QTreeView::indicator:hover,
QListView::indicator:hover {
    border-color: rgba(133, 153, 234, 0.6);
    background-color: #1a1b26;
}

QTreeView::indicator:checked,
QListView::indicator:checked {
    background-color: #8599ea;
    border-color: #8599ea;
    image: url(ASSETS_DIR_PLACEHOLDER/checkmark.svg);
}

QTreeView::indicator:indeterminate,
QListView::indicator:indeterminate {
    background-color: rgba(133, 153, 234, 0.4);
    border-color: #8599ea;
}

/* ── TABLE VIEW ──────────────────────────────────────────────────────────────── */
QTableView,
QTableWidget {
    background-color: #0e0f15;
    border: 1px solid #1e1f2b;
    border-radius: 6px;
    gridline-color: #1a1b26;
    outline: none;
    alternate-background-color: #11121a;
    selection-background-color: rgba(133, 153, 234, 0.22);
    selection-color: #b8c0f0;
}

QTableView::item,
QTableWidget::item {
    padding: 4px 8px;
    border: none;
    color: #b8c0f0;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: rgba(234, 133, 153, 0.12);
    color: #EA8599;
}

QTableView::item:selected:active,
QTableWidget::item:selected:active {
    background-color: rgba(133, 153, 234, 0.25);
    color: #b8c0f0;
}

QTableView::item:selected:!active,
QTableWidget::item:selected:!active {
    background-color: rgba(133, 153, 234, 0.08);
    color: #7a82a8;
}


/* ── BUTTONS ─────────────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #11121a;
    color: #b8c0f0;
    border: 1px solid rgba(133, 153, 234, 0.5);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
}

QPushButton:hover {
    background-color: #1a1b26;
    color: #EAD685;
    border-color: #EAD685;
}

QPushButton:pressed {
    background-color: rgba(133, 153, 234, 0.25);
    color: #8599ea;
    border-color: #8599ea;
}

QPushButton:checked {
    background-color: rgba(133, 153, 234, 0.2);
    color: #8599ea;
    border-color: #8599ea;
}

QPushButton:disabled {
    background-color: transparent;
    color: #333a52;
    border-color: #1e1f2b;
}

QPushButton:focus {
    outline: none;
    border: 1px solid #EAD685;
}

/* ── TOOL BUTTONS ────────────────────────────────────────────────────────────── */
QToolButton {
    background-color: transparent;
    color: #b8c0f0;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: rgba(133, 153, 234, 0.15);
    border-color: rgba(133, 153, 234, 0.4);
    color: #EAD685;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: rgba(133, 153, 234, 0.25);
    border-color: #8599ea;
    color: #8599ea;
}

/* ── LINE EDITS ──────────────────────────────────────────────────────────────── */
QLineEdit {
    background-color: #11121a;
    border: 1px solid #2a2c3e;
    border-bottom: 2px solid rgba(133, 153, 234, 0.4);
    color: #b8c0f0;
    padding: 6px 10px;
    border-radius: 6px;
    selection-background-color: #8599ea;
    selection-color: #0b0c10;
}

QLineEdit:hover {
    border-bottom: 2px solid rgba(133, 153, 234, 0.7);
    background-color: #13141e;
}

QLineEdit:focus {
    outline: none;
    border: 1px solid rgba(133, 153, 234, 0.5);
    border-bottom: 2px solid #8599ea;
    background-color: #1a1b26;
}

QLineEdit:disabled {
    color: #333a52;
    border-color: #1a1b26;
    border-bottom-color: #1a1b26;
    background-color: #0d0e13;
}

QLineEdit::placeholder {
    color: #333a52;
}

/* ── SEARCH BAR + COLUMN-SCOPE PICKER (fused into one control) ───────────────── */
QLineEdit#searchBarField {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}

QLineEdit#searchBarField:focus {
    border-right: none;
}

QToolButton#searchColumnBtn {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-left: 1px solid #2a2c3e;
    background-color: #11121a;
}

QToolButton#searchColumnBtn:hover {
    border-left-color: rgba(133, 153, 234, 0.7);
}

/* ── TEXT EDIT / PLAIN TEXT ──────────────────────────────────────────────────── */
QTextEdit,
QPlainTextEdit {
    background-color: #11121a;
    border: 1px solid #2a2c3e;
    color: #b8c0f0;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #8599ea;
    selection-color: #0b0c10;
}

QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: rgba(133, 153, 234, 0.6);
}

/* ── COMBO BOX ───────────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #11121a;
    border: 1px solid #2a2c3e;
    border-bottom: 2px solid rgba(133, 153, 234, 0.4);
    color: #b8c0f0;
    padding: 5px 10px;
    border-radius: 6px;
    min-width: 80px;
}

QComboBox:hover {
    border-bottom-color: rgba(133, 153, 234, 0.7);
}

QComboBox:focus {
    outline: none;
    border-bottom: 2px solid #8599ea;
}

QComboBox:disabled {
    color: #333a52;
    border-color: #1a1b26;
    border-bottom-color: #1a1b26;
    background-color: #0d0e13;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #8599ea;
}

QComboBox QAbstractItemView {
    background-color: #1a1b26;
    border: 1px solid rgba(133, 153, 234, 0.4);
    border-radius: 6px;
    color: #b8c0f0;
    selection-background-color: rgba(133, 153, 234, 0.25);
    selection-color: #b8c0f0;
    padding: 2px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(234, 133, 153, 0.12);
    color: #EA8599;
}

/* ── SPIN BOX ────────────────────────────────────────────────────────────────── */
QSpinBox,
QDoubleSpinBox {
    background-color: #11121a;
    border: 1px solid #2a2c3e;
    border-bottom: 2px solid rgba(133, 153, 234, 0.4);
    color: #b8c0f0;
    padding: 5px 8px;
    border-radius: 6px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    outline: none;
    border-bottom: 2px solid #8599ea;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 0px;
    height: 0px;
    border: none;
}

/* ── LABELS ──────────────────────────────────────────────────────────────────── */
QLabel {
    color: #b8c0f0;
    background: transparent;
    padding: 0;
}

/* Section/title labels — use objectName or property in code if desired */
QLabel[title="true"] {
    color: #EAD685;
    font-size: 1.1em;
    font-weight: bold;
    letter-spacing: 0.04em;
}

/* ── SLIDERS ─────────────────────────────────────────────────────────────────── */
QSlider::groove:horizontal {
    height: 4px;
    background: #1e1f2b;
    border-radius: 2px;
    margin: 0 2px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #9385ea,
        stop:1 #8599ea
    );
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: #1e1f2b;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #b8c0f0;
    border: 2px solid #8599ea;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #EAD685;
    border-color: #EAD685;
}

QSlider::handle:horizontal:pressed {
    background: #8599ea;
    border-color: #9385ea;
}

QSlider::groove:vertical {
    width: 4px;
    background: #1e1f2b;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #8599ea;
    border-radius: 2px;
}

QSlider::add-page:vertical {
    background: #1e1f2b;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background: #b8c0f0;
    border: 2px solid #8599ea;
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:disabled,
QSlider::handle:vertical:disabled {
    background: #555e7a;
    border-color: #333a52;
}

QSlider::sub-page:horizontal:disabled,
QSlider::sub-page:vertical:disabled {
    background: #333a52;
}

/* ── SCROLLBARS ──────────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px 0;
    border-radius: 4px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px;
    border-radius: 4px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: rgba(133, 153, 234, 0.25);
    border-radius: 4px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: rgba(133, 153, 234, 0.55);
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: #8599ea;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    height: 0px;
    width: 0px;
}

QScrollBar::corner {
    background: #0b0c10;
    border: none;
}

/* ── CHECKBOXES ──────────────────────────────────────────────────────────────── */
QCheckBox {
    color: #b8c0f0;
    background: transparent;
    spacing: 8px;
    padding: 2px 0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a3d55;
    background-color: #11121a;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: rgba(133, 153, 234, 0.6);
    background-color: #1a1b26;
}

QCheckBox::indicator:checked {
    background-color: #8599ea;
    border-color: #8599ea;
    image: url(ASSETS_DIR_PLACEHOLDER/checkmark.svg);
}

QCheckBox::indicator:checked:hover {
    background-color: #9385ea;
    border-color: #9385ea;
}

QCheckBox::indicator:indeterminate {
    background-color: rgba(133, 153, 234, 0.4);
    border-color: #8599ea;
}

QCheckBox::indicator:disabled {
    background-color: #0d0e13;
    border-color: #1a1b26;
}

QCheckBox:disabled {
    color: #333a52;
}

/* ── RADIO BUTTONS ───────────────────────────────────────────────────────────── */
QRadioButton {
    color: #b8c0f0;
    background: transparent;
    spacing: 8px;
    padding: 2px 0;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3a3d55;
    background-color: #11121a;
    border-radius: 8px;
}

QRadioButton::indicator:hover {
    border-color: rgba(133, 153, 234, 0.6);
}

QRadioButton::indicator:checked {
    background-color: #8599ea;
    border: 3px solid #1a1b26;
}

QRadioButton::indicator:disabled {
    background-color: #0d0e13;
    border-color: #1a1b26;
}

QRadioButton:disabled {
    color: #333a52;
}

/* ── TABS ────────────────────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #1e1f2b;
    border-top: none;
    background-color: #0e0f15;
    border-radius: 0 0 8px 8px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background-color: #0b0c10;
    color: #555e7a;
    padding: 8px 18px;
    margin-right: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #1e1f2b;
    border-bottom: none;
    font-size: 0.9em;
    letter-spacing: 0.02em;
}

QTabBar::tab:hover {
    background-color: #11121a;
    color: #EA8599;
    border-color: rgba(234, 133, 153, 0.35);
}

QTabBar::tab:selected {
    background-color: #0e0f15;
    color: #b8c0f0;
    border-color: rgba(133, 153, 234, 0.4);
    border-bottom: 2px solid #8599ea;
    padding-bottom: 6px;
}

QTabBar::tab:disabled {
    color: #333a52;
}

/* ── PROGRESS BAR ────────────────────────────────────────────────────────────── */
QProgressBar {
    border: 1px solid #1e1f2b;
    border-radius: 6px;
    background-color: #11121a;
    text-align: center;
    color: #b8c0f0;
    font-size: 0.8em;
    height: 12px;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #9385ea,
        stop:1 #8599ea
    );
    border-radius: 5px;
}

/* ── MENU BAR & MENUS ────────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #0b0c10;
    color: #b8c0f0;
    border-bottom: 1px solid #1e1f2b;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background-color: rgba(133, 153, 234, 0.15);
    color: #EAD685;
}

QMenuBar::item:pressed {
    background-color: rgba(133, 153, 234, 0.25);
}

QMenu {
    background-color: #1a1b26;
    border: 1px solid rgba(133, 153, 234, 0.3);
    border-radius: 8px;
    color: #b8c0f0;
    padding: 4px;
}

QMenu::item {
    padding: 7px 28px 7px 12px;
    border-radius: 5px;
    background: transparent;
}

QMenu::item:selected {
    background-color: rgba(133, 153, 234, 0.2);
    color: #EAD685;
}

QMenu::item:disabled {
    color: #333a52;
}

QMenu::separator {
    height: 1px;
    background: #2a2c3e;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 8px;
}

/* ── TOOLBAR ─────────────────────────────────────────────────────────────────── */
QToolBar {
    background-color: #0e0f15;
    border-bottom: 1px solid #1e1f2b;
    spacing: 3px;
    padding: 3px 6px;
}

QToolBar::separator {
    width: 1px;
    background: #2a2c3e;
    margin: 4px 4px;
}

/* ── STATUS BAR ──────────────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #0b0c10;
    color: #555e7a;
    border-top: 1px solid #1e1f2b;
    font-size: 0.85em;
}

QStatusBar::item {
    border: none;
}

/* ── GROUPBOX ────────────────────────────────────────────────────────────────── */
QGroupBox {
    background-color: rgba(17, 18, 26, 0.6);
    border: 1px solid #1e1f2b;
    border-radius: 8px;
    padding: 12px 10px 10px 10px;
    margin-top: 1.4em;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    background-color: #0b0c10;
    color: #8599ea;
    font-size: 0.9em;
    letter-spacing: 0.05em;
}

/* ── SPLITTER ────────────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #1e1f2b;
}

QSplitter::handle:hover {
    background-color: rgba(133, 153, 234, 0.4);
}

QSplitter::handle:pressed {
    background-color: #8599ea;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

/* ── TOOLTIP ─────────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1a1b26;
    color: #b8c0f0;
    border: 1px solid rgba(133, 153, 234, 0.4);
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 0.85em;
    opacity: 230;
}

/* ── MESSAGE BOX ─────────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #11121a;
    color: #b8c0f0;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 16px;
}

/* ── SCROLL AREA ─────────────────────────────────────────────────────────────── */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* ── FRAME ───────────────────────────────────────────────────────────────────── */
QFrame {
    background: transparent;
}

QFrame[frameShape="4"],  /* HLine */
QFrame[frameShape="5"] { /* VLine */
    color: #1e1f2b;
    background-color: #1e1f2b;
    border: none;
    max-height: 1px;
}

/* ── STACKED WIDGET ──────────────────────────────────────────────────────────── */
QStackedWidget {
    background-color: #0b0c10;
}

/* ── CALENDAR WIDGET ─────────────────────────────────────────────────────────── */
QCalendarWidget {
    background-color: #11121a;
    color: #b8c0f0;
}

QCalendarWidget QToolButton {
    color: #b8c0f0;
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: rgba(133, 153, 234, 0.2);
}

QCalendarWidget QAbstractItemView {
    background-color: #0e0f15;
    color: #b8c0f0;
    selection-background-color: rgba(133, 153, 234, 0.25);
    selection-color: #b8c0f0;
}

/* ── SPECIAL: PlaceList ───────────────────────────────────────────────────────── */
QListWidget#placeList {
    background-color: #0e0f15;
    border: 1px solid #1e1f2b;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    color: #b8c0f0;
}

QListWidget#placeList::item {
    background-color: transparent;
    padding: 6px 10px;
    margin: 1px 0;
    border-radius: 4px;
}

QListWidget#placeList::item:hover {
    background-color: rgba(133, 153, 234, 0.1);
    border: 1px solid rgba(133, 153, 234, 0.25);
    color: #EA8599;
}

QListWidget#placeList::item:selected:active {
    background-color: rgba(133, 153, 234, 0.22);
    color: #b8c0f0;
    border: 1px solid rgba(133, 153, 234, 0.5);
}

QListWidget#placeList::item:selected:!active {
    background-color: rgba(133, 153, 234, 0.08);
    color: #7a82a8;
    border: 1px solid rgba(133, 153, 234, 0.2);
}


QListWidget#placeList:focus {
    border: 1px solid rgba(133, 153, 234, 0.5);
}

/* ── SPECIAL: Player Dock ─────────────────────────────────────────────────────── */
QDockWidget#PlayerDock {
    border-top: 2px solid rgba(133, 153, 234, 0.25);
}

QDockWidget#PlayerDock > QWidget {
    background-color: #0e0f15;
}

QLabel#PlayerTrackLabel {
    color: #b8c0f0;
    font-style: italic;
    font-size: 1.3em;
}

QLabel#PlayerArtistLabel {
    color: #8599ea;
    font-size: 1.0em;
}

QLabel#PlayerAlbumLabel {
    color: #EAD685;
    font-size: 1.0em;
}

QLabel#PlayerPositionLabel {
    font-size: 1.4em;
}

/* ── SPECIAL: Queue Dock (QueueDockWidget) ───────────────────────────────────── */
QFrame#NowPlayingCard {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(133,153,234,0.18),
        stop:1 rgba(133,153,234,0.06)
    );
    border: none;
    border-left: 3px solid #8599ea;
    border-radius: 0px;
}

QLabel#NowPlayingTag {
    color: #8599ea;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 0.12em;
    background: transparent;
}

QLabel#NowPlayingTitle {
    color: #b8c0f0;
    background: transparent;
}

QLabel#NowPlayingSubtitle {
    color: #555e7a;
    font-size: 11px;
    background: transparent;
}

QFrame#QueueDivider {
    background: rgba(133, 153, 234, 0.25);
    border: none;
}

QWidget#QueueSurfacePanel {
    background: #11121a;
}

QLabel#QueueSectionLabel {
    color: #555e7a;
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 0.12em;
    background: transparent;
}

QLabel#QueueCountLabel {
    color: #555e7a;
    font-size: 9px;
    background: transparent;
}

QLabel#QueueStatusLabel {
    color: #8599ea;
    font-size: 10px;
    background: transparent;
}

QListView#QueueListView {
    background: #0b0c10;
    border: none;
    outline: none;
    font-family: "Cambria", "Georgia", serif;
    font-size: 12px;
    color: #b8c0f0;
}

QListView#QueueListView::item {
    padding: 7px 14px;
    border-bottom: 1px solid rgba(30,31,43,0.6);
    border-radius: 0px;
    color: #b8c0f0;
}

QListView#QueueListView::item:hover {
    background: rgba(234,133,153,0.1);
    color: #EA8599;
}

QListView#QueueListView::item:selected {
    background: rgba(133,153,234,0.2);
    color: #b8c0f0;
}

QListView#QueueListView QScrollBar:vertical {
    background: #0b0c10;
    width: 6px;
    margin: 0;
}

QListView#QueueListView QScrollBar::handle:vertical {
    background: rgba(133,153,234,0.35);
    border-radius: 3px;
    min-height: 30px;
}

QListView#QueueListView QScrollBar::handle:vertical:hover {
    background: rgba(133,153,234,0.6);
}

QListView#QueueListView QScrollBar::add-line:vertical,
QListView#QueueListView QScrollBar::sub-line:vertical {
    height: 0;
}

QPushButton#QueueRemoveButton {
    background: transparent;
    color: #555e7a;
    border: 1px solid rgba(234,133,153,0.3);
    border-radius: 6px;
    padding: 3px 12px;
    font-size: 11px;
}

QPushButton#QueueRemoveButton:hover {
    color: #EA8599;
    border-color: #EA8599;
    background: rgba(234,133,153,0.08);
}

QPushButton#QueueRemoveButton:pressed {
    background: rgba(234,133,153,0.15);
}

/* ── SPECIAL: "Now Playing" list item ────────────────────────────────────────── */
QListWidget::item[text="Now Playing"] {
    background-color: rgba(133, 153, 234, 0.18);
    color: #EAD685;
    font-weight: bold;
    border-left: 3px solid #8599ea;
    border-radius: 4px;
}

/* =============================================================================
   DYNAMIC PROPERTY-DRIVEN RULES
   Widgets set these via widget.setProperty("name", value) instead of calling
   setStyleSheet() directly. For properties that change after a widget is first
   shown, call widget.style().unpolish(widget); widget.style().polish(widget)
   after setProperty() to force Qt to re-evaluate the stylesheet.
============================================================================= */

/* ── GENERIC: transparent background override for plain QWidget containers ──
   Only needed on bare QWidget instances — QLabel/QFrame/QScrollArea are
   already transparent by default (see their base rules above). */
QWidget[bgTransparent="true"] {
    background: transparent;
}

/* ── TEXT ROLES: secondary/dim labels (notes, hints, status, placeholders) ──── */
QLabel[textRole="muted"] {
    color: #555e7a;
}

QLabel[textRole="note"] {
    color: #555e7a;
    font-style: italic;
}

QLabel[textRole="placeholder"] {
    color: #555e7a;
    font-style: italic;
    padding: 20px;
}

/* ── DESTRUCTIVE / WARNING ACTIONS ───────────────────────────────────────────── */
QPushButton[danger="true"] {
    color: #EA8599;
    border-color: transparent;
}

QPushButton[danger="true"]:hover {
    border-color: #EA8599;
    background-color: rgba(234, 133, 153, 0.12);
}

QLabel[danger="true"] {
    color: #EA8599;
    font-weight: bold;
}

/* ── COMPACT ROW-LEVEL ACTION BUTTONS (Edit / Swap / Delete style rows) ──────── */
QPushButton[rowAction="true"] {
    border: 1px solid palette(mid);
    border-radius: 3px;
    padding: 1px 6px;
}

QPushButton[rowAction="true"]:hover {
    background: palette(highlight);
    color: palette(highlighted-text);
}

/* ── QUEUE DOCK TOOLBAR BUTTONS (Shuffle / Clear) ────────────────────────────── */
QPushButton[queueTool="true"] {
    background: transparent;
    color: #555e7a;
    border: 1px solid rgba(133,153,234,0.22);
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
}

QPushButton[queueTool="true"]:hover {
    color: #EAD685;
    border-color: #EAD685;
    background: rgba(234,214,133,0.08);
}

QPushButton[queueTool="true"]:pressed {
    background: rgba(133,153,234,0.15);
    color: #8599ea;
    border-color: #8599ea;
}

/* ── PLAYER DOCK TRANSPORT BUTTONS (previous/play/pause/stop/next) ──────────── */
QPushButton[playerCtrlBtn="true"] {
    border: none;
    background: transparent;
}

/* ── CHIP / SEGMENTED TOGGLE BUTTONS (checkable QPushButtons) ───────────────── */
QPushButton[chip="true"] {
    border: 1px solid rgba(133, 153, 234, 0.5);
    border-radius: 11px;
    padding: 3px 12px;
    background: transparent;
    color: #b8c0f0;
}

QPushButton[chip="true"]:checked {
    background: #8599ea;
    color: #0b0c10;
    border-color: #8599ea;
}

QPushButton[chip="true"]:hover:!checked {
    background: rgba(133, 153, 234, 0.15);
}

QPushButton[segment="true"] {
    border: 1px solid rgba(133, 153, 234, 0.5);
    padding: 4px 12px;
    background: transparent;
    color: #b8c0f0;
}

QPushButton[segment="true"]:checked {
    background: #8599ea;
    color: #0b0c10;
    font-weight: 600;
}

QPushButton[segment="left"] {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QPushButton[segment="right"] {
    border-left: none;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/* ── "NOW PLAYING" TAB BAR (lyrics/credits) ──────────────────────────────────── */
QPushButton[npTab="true"] {
    background: transparent;
    border: 1px solid rgba(133, 153, 234, 0.14);
    border-bottom: none;
    border-radius: 0px;
    color: rgba(133, 153, 234, 0.42);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    padding: 5px 22px;
}

QPushButton[npTab="true"]:hover {
    background: rgba(133, 153, 234, 0.09);
    color: rgba(200, 208, 244, 0.70);
}

QPushButton[npTab="true"][active="true"] {
    background: rgba(133, 153, 234, 0.20);
    border: 1px solid rgba(133, 153, 234, 0.55);
    border-bottom: none;
    color: rgba(230, 235, 255, 0.92);
}

/* ── "NOW PLAYING" small pill toggles (sync/mode) ────────────────────────────── */
QPushButton[npToggle="true"] {
    background: transparent;
    border: 1px solid rgba(133, 153, 234, 0.22);
    border-radius: 8px;
    color: rgba(133, 153, 234, 0.45);
    font-size: 9px;
    font-weight: bold;
    letter-spacing: 1px;
    padding: 2px 8px;
}

QPushButton[npToggle="true"]:hover {
    background: rgba(133, 153, 234, 0.10);
    color: rgba(200, 208, 244, 0.70);
}

QPushButton[npToggle="true"][active="true"] {
    background: rgba(133, 153, 234, 0.22);
    border: 1px solid rgba(133, 153, 234, 0.50);
    color: rgba(230, 235, 255, 0.90);
}

/* ── "NOW PLAYING" metadata chip pills ───────────────────────────────────────── */
QLabel[npChip="true"] {
    background: rgba(133, 153, 234, 0.13);
    border: 1px solid rgba(133, 153, 234, 0.28);
    border-radius: 10px;
    color: rgba(200, 208, 244, 0.80);
    font-size: 10px;
    padding: 2px 10px;
}

/* ── "NOW PLAYING" tab-bar divider rule ──────────────────────────────────────── */
QFrame[npRule="true"] {
    border: none;
    border-top: 1px solid rgba(133, 153, 234, 0.25);
}

/* ── "NOW PLAYING" credit card (one per artist-role row) ─────────────────────── */
QWidget[npCreditCard="true"] {
    background: rgba(133, 153, 234, 0.07);
    border: 1px solid rgba(133, 153, 234, 0.18);
    border-radius: 8px;
}

/* ── "NOW PLAYING" labels — color/style variants keyed by role ──────────────── */
QLabel[npRole="title"] {
    color: rgba(230, 235, 255, 0.94);
}

QLabel[npRole="album"] {
    color: rgba(150, 160, 210, 0.50);
}

QLabel[npRole="nextLyric"] {
    color: rgba(133, 153, 234, 0.38);
    font-style: italic;
}

QLabel[npRole="plainLyrics"] {
    color: rgba(200, 208, 244, 0.75);
    line-height: 1.7em;
}

QLabel[npRole="noLyrics"] {
    color: rgba(133, 153, 234, 0.28);
    font-size: 14px;
    font-style: italic;
}

QLabel[npRole="countdown"] {
    color: rgba(133, 153, 234, 0.55);
    font-size: 13px;
    font-style: italic;
}

QLabel[npRole="offsetLabel"] {
    color: rgba(133, 153, 234, 0.45);
    font-size: 10px;
}

QLabel[npRole="creditsPlaceholder"] {
    color: rgba(133, 153, 234, 0.28);
    font-size: 13px;
    font-style: italic;
}

QLabel[npRole="creditsRole"] {
    color: rgba(133, 153, 234, 0.55);
    font-size: 10px;
}

QLabel[npRole="creditsName"] {
    color: rgba(210, 218, 255, 0.88);
    font-size: 13px;
}

/* ── "NOW PLAYING" lyrics scroll area (plain-text mode) ──────────────────────── */
QScrollArea#NowPlayingLyricsScrollArea {
    background: transparent;
    border: none;
}

QScrollArea#NowPlayingLyricsScrollArea QScrollBar:vertical {
    width: 4px;
    background: transparent;
}

QScrollArea#NowPlayingLyricsScrollArea QScrollBar::handle:vertical {
    background: rgba(133, 153, 234, 0.30);
    border-radius: 2px;
}

QScrollArea#NowPlayingLyricsScrollArea QScrollBar::add-line:vertical,
QScrollArea#NowPlayingLyricsScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ── "NOW PLAYING" lyric sync-offset slider ──────────────────────────────────── */
QSlider#NowPlayingSyncSlider::groove:horizontal {
    height: 2px;
    background: rgba(133, 153, 234, 0.25);
    border-radius: 1px;
}

QSlider#NowPlayingSyncSlider::handle:horizontal {
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
    background: rgba(133, 153, 234, 0.60);
}

QSlider#NowPlayingSyncSlider::sub-page:horizontal {
    background: rgba(133, 153, 234, 0.50);
    border-radius: 1px;
}

/* ── SPECIAL: Album edit header byline ("by Artist Name") ────────────────────── */
QLabel#albumByline {
    color: #555e7a;
    font-size: 14px;
}

/* ── SPECIAL: Album cover placeholder (no art set) ───────────────────────────── */
QLabel[coverPlaceholder="true"] {
    border: 1px solid #2a2c3e;
    background: #1a1b26;
    color: #555e7a;
}

/* ── SPECIAL: SyncView DeviceCard ────────────────────────────────────────────── */
DeviceCard {
    background: rgba(17, 18, 26, 0.6);
    border: 1px solid #1e1f2b;
    border-radius: 8px;
}

DeviceCard:hover {
    background: rgba(133, 153, 234, 0.07);
    border-color: rgba(133, 153, 234, 0.3);
}

DeviceCard[selected="true"] {
    background: rgba(133, 153, 234, 0.15);
    border: 1px solid rgba(133, 153, 234, 0.5);
}

/* SyncView DeviceCard subtitle — always dim */
QLabel#CardSub {
    color: #555e7a;
    font-size: 11px;
}

/* USB/folder connection badge — state: "connected" | "disconnected" | "folder" */
QLabel#CardBadge {
    border-radius: 9px;
    padding: 0 7px;
    font-size: 10px;
    font-weight: bold;
}

QLabel#CardBadge[state="connected"] {
    background: #1a3a1a;
    color: #99EA85;
}

QLabel#CardBadge[state="disconnected"] {
    background: #2a2c3e;
    color: #555e7a;
}

QLabel#CardBadge[state="folder"] {
    background: #1a1b2a;
    color: #8599ea;
}

/* SyncView linked-device label — "connected" | "idle" (linked-but-offline / none) */
QLabel[linkState="connected"] {
    color: #99EA85;
    font-weight: bold;
}

QLabel[linkState="idle"] {
    color: #555e7a;
}

/* ── SPECIAL: Album/AlbumChip selection ──────────────────────────────────────── */
QFrame#albumChip {
    background: rgba(17, 18, 26, 0.6);
    border: 1px solid #1e1f2b;
    border-radius: 6px;
}

QFrame#albumChip[selected="true"] {
    background: #8599ea;
    border: 1px solid #8599ea;
}

QLabel#albumChipTitle {
    font-weight: 600;
}

QLabel#albumChipSub {
    color: #555e7a;
    font-size: 11px;
}

QFrame#albumChip[selected="true"] QLabel#albumChipTitle,
QFrame#albumChip[selected="true"] QLabel#albumChipSub {
    color: #0b0c10;
}

/* ── SPECIAL: Album grid item (AlbumWidget) ──────────────────────────────────── */
AlbumWidget QLabel#AlbumTitleLabel {
    font-weight: bold;
    font-size: 1.1em;
}

AlbumWidget QLabel#AlbumArtistLabel {
    color: #555e7a;
}

AlbumWidget[selected="true"] {
    border: 2px solid #8599ea;
    background-color: rgba(133, 153, 234, 0.15);
    border-radius: 4px;
}

/* ── SPECIAL: StatusBarWidget floating overlay ────────────────────────────────── */
StatusBarWidget[mode="float"] {
    background-color: rgba(20, 21, 30, 0.72);
    border: 1px solid rgba(184, 192, 240, 0.25);
    border-radius: 8px;
    min-height: 36px;
    max-height: 36px;
}

StatusBarWidget[mode="float"] QLabel {
    color: #d6dbf7;
    font-size: 12px;
}

StatusBarWidget[mode="float"] QPushButton {
    color: #d6dbf7;
}

/* ── SPECIAL: Disc management status message ─────────────────────────────────── */
QLabel[statusState="ok"] {
    color: #99EA85;
    font-size: 11px;
}

QLabel[statusState="error"] {
    color: #EA8599;
    font-size: 11px;
}

/* ── SPECIAL: Artist detail header (HeaderWidget) ────────────────────────────── */
HeaderWidget QLabel#ArtistName {
    font-size: 28px;
    font-weight: bold;
    color: #b8c0f0;
}

HeaderWidget QLabel#TypeBadge {
    background-color: #1a1b26;
    color: #8599ea;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 500;
    margin-left: 8px;
}

HeaderWidget QLabel#AliasLabel {
    font-size: 14px;
    color: #555e7a;
    font-style: italic;
}

HeaderWidget QLabel#DateLabel {
    font-size: 14px;
    color: #b8c0f0;
}

HeaderWidget QLabel#AgeLabel {
    font-size: 13px;
    color: #555e7a;
    font-weight: 500;
}

HeaderWidget QLabel#PlaceLabel {
    font-size: 13px;
    color: #7a82a8;
}

HeaderWidget QLabel#InfoLabel {
    font-size: 12px;
    color: #b8c0f0;
    padding: 2px 6px;
    background-color: #1a1b26;
    border-radius: 4px;
}

HeaderWidget QLabel#GroupLabel {
    font-size: 12px;
    color: #0b0c10;
    background-color: #8599ea;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 500;
}

ArtistInfobox {
    background-color: #1a1b26;
    border: 1px solid #1e1f2b;
    border-radius: 8px;
    padding: 10px;
}

HeaderWidget QLabel#ArtistPortrait {
    background-color: #12131c;
    border: 1px solid #1e1f2b;
    border-radius: 6px;
}

/* ── SPECIAL: Artist article sections and jump nav (ArtistDetailTab) ────────── */
ArtistDetailTab QLabel#SectionHeading {
    font-size: 18px;
    font-weight: 600;
    color: #b8c0f0;
    padding-bottom: 4px;
    border-bottom: 1px solid #1e1f2b;
}

ArtistDetailTab QLabel#TocLabel {
    font-size: 12px;
    color: #555e7a;
}

ArtistDetailTab QPushButton#TocChip {
    font-size: 12px;
    color: #8599ea;
    background-color: #1a1b26;
    border: 1px solid #1e1f2b;
    border-radius: 10px;
    padding: 3px 10px;
}

ArtistDetailTab QPushButton#TocChip:hover {
    background-color: #23253a;
    color: #b8c0f0;
}
